  {
    "key": "group_lumiboo_account_fixtures",
    "title": "Espace compte — dossiers de démonstration",
    "fields": [
      {
        "key": "field_lum_fixtures",
        "label": "Dossiers de démonstration",
        "name": "account_fixtures",
        "type": "repeater",
        "layout": "row",
        "button_label": "Ajouter un dossier",
        "min": 0,
        "instructions": "Jeux de données servant à valider tous les états de l’espace compte sans dépendre de vraies commandes. Laisser vide pour utiliser les dossiers livrés avec le thème.",
        "sub_fields": [
          { "key": "field_lum_fx_id", "label": "Identifiant", "name": "id", "type": "text", "instructions": "Utilisé dans l’URL de personnalisation. Minuscules et tirets.", "wrapper": { "width": "25" } },
          { "key": "field_lum_fx_reference", "label": "Référence", "name": "reference", "type": "text", "wrapper": { "width": "25" } },
          { "key": "field_lum_fx_product", "label": "Produit", "name": "product", "type": "select", "choices": { "premium": "Premium", "studio": "Studio" }, "default_value": "premium", "wrapper": { "width": "25" } },
          { "key": "field_lum_fx_prints", "label": "Impressions", "name": "prints", "type": "select", "choices": { "": "—", "400": "400 (Lite)", "800": "800 (Pro)", "unlimited": "Illimité (Ultra)" }, "allow_null": 1, "wrapper": { "width": "25" } },
          { "key": "field_lum_fx_roll", "label": "Rouleau supplémentaire", "name": "has_roll", "type": "true_false", "ui": 1, "wrapper": { "width": "25" } },
